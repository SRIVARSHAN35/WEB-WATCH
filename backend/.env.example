# SMTP settings. Replace placeholders in your local backend/.env only.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=<smtp-account-address>
EMAIL_HOST_PASSWORD=<smtp-app-password>
DEFAULT_FROM_EMAIL=<verified-sender-address>
EMAIL_TIMEOUT=30

# Optional public HTTPS URL for the banner image. When unset, the banner is
# embedded in each message using a CID attachment from monitor/static/monitor/.
WEBWATCH_EMAIL_BANNER_URL=

# Optional valid public WebWatch dashboard URL shown in notification footers.
WEBWATCH_DASHBOARD_URL=

# Meta WhatsApp Cloud API. Keep the access token only in this backend .env.
WHATSAPP_ENABLED=False
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Set this to a currently supported version in the Meta Developers docs (for example v26.0).
WHATSAPP_GRAPH_API_VERSION=
# Optional: an approved WhatsApp template with exactly three body text parameters.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en
# Optional exact local-network hostnames for direct Django access.
DJANGO_ALLOWED_HOSTS=YOUR-PC-LAN-IP

# Only needed if the browser calls Django directly instead of using Vite's /api proxy.
CORS_ALLOWED_ORIGINS_EXTRA=http://YOUR-PC-LAN-IP:5173
CSRF_TRUSTED_ORIGINS_EXTRA=http://YOUR-PC-LAN-IP:5173

# Keep detailed Django debug pages disabled when the backend is reachable publicly.
DEBUG=False
SECRET_KEY=replace-with-a-random-Django-secret-key
GOOGLE_CLIENT_ID=your-web-oauth-client-id.apps.googleusercontent.com
